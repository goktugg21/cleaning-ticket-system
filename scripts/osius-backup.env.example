# ============================================================
# Template for /etc/osius-backup.env — the credentials scripts/
# backup_restic.sh reads for the nightly off-site encrypted backup.
#
# This file is a TEMPLATE ONLY. It documents the variable names; it is
# NOT read by the script itself (the script reads the real file at
# /etc/osius-backup.env, root-only, never checked into this repo — see
# CLAUDE.md's "never commit a real value" rule and docs/operations/
# backups.md for full provisioning steps).
#
# Copy this file to /etc/osius-backup.env on the production host, fill
# in real values, then:
#   chown root:root /etc/osius-backup.env
#   chmod 600 /etc/osius-backup.env
# ============================================================

# ---- restic repository ----
# The restic repository URL. For a Hetzner Storage Box over SFTP (see
# docs/operations/backups.md for account provisioning + SSH key setup —
# password auth will NOT work unattended from a systemd timer):
#   RESTIC_REPOSITORY=sftp:uXXXXXX@uXXXXXX.your-storagebox.de:/backups/cleaning-ticket
# Any other restic-supported backend (S3, B2, a local path for testing)
# works the same way — see https://restic.readthedocs.io/en/stable/030_preparing_a_new_repo.html
RESTIC_REPOSITORY=replace-with-your-restic-repository-url

# The repository's ENCRYPTION password. This is not your Storage Box
# account password — it is a separate secret restic uses to encrypt
# every snapshot. Generate one with:
#   openssl rand -base64 32
# LOSE THIS AND EVERY SNAPSHOT IS UNRECOVERABLE, even with full access
# to the repository storage. Store a copy somewhere OTHER than this
# server (a password manager, not another file on the same disk).
RESTIC_PASSWORD=replace-with-a-strong-random-password
